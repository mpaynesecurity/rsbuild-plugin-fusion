{
	"name": "@mpaynesecurity/rsbuild-plugin-fusion",
	"version": "2.0.0",
	"type": "module",
	"license": "MIT",
	"description": "Turns any Rsbuild SPA into a lightweight fullstack framework",
	"keywords": [
		"rsbuild",
		"rspack",
		"bun",
		"oxc",
		"full stack",
		"magic-string",
		"ast-transform",
		"client-server-compiler"
	],
	"funding": {
		"type": "ko-fi",
		"url": "https://ko-fi.com/mpaynesecurity"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./virtual": "./dist/globals.d.ts"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/mpaynesecurity/rsbuild-plugin-fusion.git",
		"directory": "packages/plugin"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"plugin-build": "bun --bun rslib",
		"plugin-build-rsdoctor": "cross-env RSDOCTOR=true rslib",
		"plugin-test": "rstest",
		"clean:node": "rm -rf node_modules",
		"clean:dist": "rm -rf dist",
		"publish:local": "pnpm publish --registry https://registry.mpaynesecurity.net",
		"unpublish:local": "pnpm unpublish @mpaynesecurity/rsbuild-plugin-fusion --registry https://registry.mpaynesecurity.net --force",
		"publish:git": "pnpm publish . --registry https://npm.pkg.github.com --no-workspaces"
	},
	"dependencies": {
		"@mpaynesecurity/rustify": "workspace:*",
		"acorn": "^8.19.0",
		"astring": "^1.9.0",
		"zimmerframe": "^1.1.5",
		"@sveltejs/acorn-typescript": "^1.0.13",
		"magic-string": "^1.4.5"
	},
	"devDependencies": {
		"@types/estree": "^1.0.10",
		"@rsdoctor/rspack-plugin": "catalog:",
		"@rsbuild/core": "catalog:",
		"@rslib/core": "catalog:",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"cross-env": "catalog:",
		"@rstest/adapter-rsbuild": "catalog:",
		"@rstest/core": "catalog:"
	},
	"peerDependencies": {
		"@rsbuild/core": "catalog:"
	}
}