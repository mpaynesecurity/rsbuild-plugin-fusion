{
	"type": "module",
	"devEngines": {
		"runtime": [
			{
				"name": "bun",
				"version": "^1.4.2"
			},
			{
				"name": "deno",
				"version": "^2.9.7"
			}
		],
		"packageManager": {
			"name": "pnpm",
			"version": "^12.8.1"
		}
	},
	"scripts": {
		"clean:deps": "rm bun.lock && rm -rf node_modules && bun run --filter '*' clean:node",
		"clean:dist": "rm -rf dist/ && bun run --filter '*' clean:dist",
		"plugin:build": "bun run --elide-lines=0 --filter '*/rsbuild-plugin-fusion' build && bun i",
		"plugin:build:rsdoctor": "bun run --filter '*/rsbuild-plugin-fusion' build:rsdoctor",
		"plugin:publish:local": "bun run --elide-lines=0 --filter '*/rsbuild-plugin-fusion' publish:local",
		"plugin:publish:git": "bun run --elide-lines=0 --filter '*/rsbuild-plugin-fusion' publish:git",
		"plugin:publish:npm": "bun run --elide-lines=0 --filter '*/rsbuild-plugin-fusion' publish:npm",
		"preview": "bun dist/index.mjs",
		"preview:build": "rm -rf dist && bun run plugin:build && bun run sandbox:build && bun run preview",
		"sandbox:build": "pnpm -r run sandbox:dev",
		"sandbox:dev": "turbo sandbox#dev"
	},
	"dependencies": {
		"@mpaynesecurity/rsbuild-plugin-fusion": "1.0.0"
	},
	"devDependencies": {
		"turbo": "^2.11.7",
		"@rsdoctor/rspack-plugin": "^1.6.3",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"cross-env": "catalog:",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"@solidjs/router": "catalog:",
		"solid-js": "catalog:",
		"@rsbuild/plugin-solid": "catalog:"
	},
	"workspaces": {
		"packages": [
			"plugin",
			"sandbox"
		],
		"catalog": {
			"@rsbuild/core": "^2.2.1",
			"@rsbuild/plugin-babel": "^2.0.1",
			"@rsbuild/plugin-solid": "^1.2.2",
			"@rsbuild/plugin-tailwindcss": "^2.0.3",
			"@rsdoctor/rspack-plugin": "^1.6.1",
			"@rslib/core": "^0.23.2",
			"@solidjs/router": "^1.0.0",
			"solid-js": "^1.9.15",
			"@types/bun": "^1.4.2",
			"@types/node": "^26.1.1",
			"cross-env": "^10.1.0",
			"typescript": "^7.0.2"
		}
	}
}
