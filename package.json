{
	"type": "module",
	"devEngines": {
		"runtime": [
			{
				"name": "bun",
				"version": "^1.4.2"
			}
		],
		"packageManager": {
			"name": "pnpm",
			"version": "^12.10.1",
			"onFail": "ignore"
		}
	},
	"keywords": [
		"rsbuild",
		"rspack",
		"bun",
		"oxc",
		"full stack",
		"magic-string",
		"ast-transform",
		"client-server-compiler"
	],
	"scripts": {
		"devtools": "turbo devtools --port 3006",
		"plugin:build": "turbo plugin-build && pnpm i",
		"plugin:build:rsdoctor": "turbo plugin-build-rsdoctor",
		"preact:build": "turbo preact-build",
		"preact:dev": "turbo preact-dev",
		"preact:test": "turbo preact-test",
		"preact:preview": "turbo preact-preview",
		"svelte:build": "turbo svelte-build",
		"svelte:dev": "turbo svelte-dev",
		"svelte:test": "turbo svelte-test",
		"svelte:preview": "turbo svelte-preview",
		"solid:build": "turbo solid-build",
		"solid:dev": "turbo solid-dev",
		"solid:test": "turbo solid-test",
		"solid:preview": "turbo solid-preview",
		"vue:build": "turbo vue-build",
		"vue:dev": "turbo vue-dev",
		"vue:test": "turbo vue-test",
		"vue:preview": "turbo vue-preview",
		"test:all": "pnpm svelte:test; pnpm solid:test; pnpm vue:test"
	},
	"devDependencies": {
		"turbo": "^2.11.7",
		"@types/bun": "catalog:",
		"@types/node": "catalog:"
	},
	"peerDependencies": {
		"@solidjs/router": "catalog:",
		"solid-js": "catalog:",
		"@rsbuild/plugin-solid": "catalog:"
	},
	"workspaces": {
		"packages": [
			"packages/*"
		],
		"catalog": {
			"@rsbuild/core": "^2.2.12",
			"vite": "^8.2.1",
			"magic-string": "^1.4.1",
			"oxc-parser": "^0.150.0",
			"oxc-walker": "^1.1.1",
			"tailwind-css": "^4.3.1",
			"@tailwindcss/vite": "^4.3.1",
			"@rstest/adapter-rsbuild": "^0.12.3",
			"@rstest/core": "^0.12.3",
			"@testing-library/dom": "^10.4.2",
			"@testing-library/jest-dom": "^7.0.1",
			"vite-plugin-inspect": "^12.0.2",
			"vite-plugin-solid": "^2.11.12",
			"@rsbuild/plugin-babel": "^2.0.1",
			"happy-dom": "^20.14.5",
			"@rsbuild/plugin-solid": "^1.2.2",
			"@rsbuild/plugin-tailwindcss": "^2.0.3",
			"@rsdoctor/rspack-plugin": "^1.6.1",
			"@rslib/core": "^1.0.3",
			"@solidjs/router": "^1.0.0",
			"solid-js": "^1.9.15",
			"@types/bun": "^1.4.2",
			"@types/node": "^26.1.1",
			"cross-env": "^10.1.0"
		}
	}
}
