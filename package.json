{
	"type": "module",
	"devEngines": {
		"runtime": [
			{
				"name": "bun",
				"version": "^1.4.2"
			}
		],
		"packageManager": {
			"name": "pnpm",
			"version": "^12",
			"onFail": "ignore"
		}
	},
	"workspaces": {
		"packages": [
			"packages/*"
		]
	},
	"scripts": {
		"devtools": "turbo devtools --port 3006",
		"plugin:build": "turbo plugin-build && pnpm i",
		"plugin:test": "turbo plugin-test",
		"plugin:build:rsdoctor": "turbo plugin-build-rsdoctor",
		"preact:build": "turbo preact-build",
		"preact:dev": "turbo preact-dev",
		"preact:test": "turbo preact-test",
		"preact:preview": "turbo preact-preview",
		"svelte:build": "turbo svelte-build",
		"svelte:dev": "turbo svelte-dev",
		"svelte:test": "turbo svelte-test",
		"svelte:preview": "turbo svelte-preview",
		"solid:build": "turbo solid-build",
		"solid:dev-node": "turbo solid-dev-node",
		"solid:dev-bun": "turbo solid-dev-bun",
		"solid:test": "turbo solid-test",
		"solid:preview": "turbo solid-preview",
		"vue:build": "turbo vue-build",
		"vue:dev": "turbo vue-dev",
		"vue:test": "turbo vue-test",
		"vue:preview": "turbo vue-preview",
		"test:all": "pnpm svelte:test; pnpm solid:test; pnpm vue:test"
	},
	"devDependencies": {
		"turbo": "^2.11.7",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"taze": "^21.3.0"
	}
}
